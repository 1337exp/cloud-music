{
  "name": "cloud-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/1337exp/cloud-music",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/cloud-music.git"
  },
  "scripts": {
    "dev": "bun src/tools/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite --config src/client/vite.config.ts",
    "build": "vite build --config src/client/vite.config.ts",
    "start": "bun src/server/index.ts",
    "user:create": "bun src/tools/create-user.ts",
    "reindex": "bun src/tools/reindex.ts",
    "demo": "bun src/tools/demo-seed.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "typecheck": "vue-tsc --noEmit -p src/client/tsconfig.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@1337exp/taoui": "5.24.0",
    "@fontsource/roboto": "^5.3.0",
    "hono": "^4.9.6",
    "jose": "^6.0.12",
    "music-metadata": "^11.9.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.12"
  }
}
